# Variables de entorno de la API en Go. En local las pone docker-compose.yml; en un hosting se configuran en su panel.

# PostgreSQL (obligatorio: sin esto la API no arranca). Usa DATABASE_URL…
# En un servicio administrado suele requerir TLS: agrega ?sslmode=require si la URL no lo trae.
DATABASE_URL=postgres://usuario:contraseña@host:5432/cineight?sslmode=require
# …o, en su lugar, las variables por separado (la contraseña puede llevar @, # o / sin codificarla):
# DB_HOST=host
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=usuario
# DB_PASSWORD=contraseña
# DB_SSLMODE=require

# Pool de conexiones: máximo y mínimo abiertas. Con el plan gratuito de Supabase (Session pooler), usa un
# máximo menor al límite de conexiones de tu plan (p. ej. DB_MAX_CONNS=10).
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Segundos que la cartelera (GET /api/funciones) se sirve desde la caché de Redis (0 = sin caché).
CACHE_CARTELERA_SEGUNDOS=15

# Redis. En un servicio administrado usa la URL completa (rediss:// = con TLS). En local basta REDIS_ADDR=localhost:6379.
REDIS_URL=rediss://default:contraseña@host:6379
# Conexiones máximas a Redis (más 2 de Pub/Sub). Deja margen bajo el límite de tu plan (Render Key Value gratuito: 50).
REDIS_POOL=20

# Orígenes que pueden llamar a la API: la URL pública del frontend (sin barra final), separadas por comas.
CORS_ORIGINS=https://tu-frontend.vercel.app

# true detrás del proxy del hosting (Render, Railway, Fly…): la IP del cliente sale de X-Forwarded-For
# y el límite anti-bots se aplica por cliente y no a todos juntos. No lo actives sin proxy.
TRUST_PROXY=true

# reCAPTCHA v3: clave SECRETA (la pública va en el frontend). Vacía = verificación desactivada.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# Cola virtual del preestreno: clientes que eligen butacas a la vez (nunca más de los que alcanzan las butacas
# que quedan) y duración de cada turno (el primer minuto es de gracia: si no bloquea una butaca, pasa al siguiente).
COLA_CAPACIDAD=5
COLA_TURNO_MINUTOS=3

# Opcionales: puerto (los hostings lo inyectan solos), retención de butacas y límites por minuto e IP.
# PORT=8080
# RETENCION_SEGUNDOS=300
# RATE_LIMIT=5
# RATE_LIMIT_INTERACTIVO=120
